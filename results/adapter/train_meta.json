    "lr": 0.0002,
    "epochs": 3,
    "per_device_batch_size": 1,
    "grad_accum": 4,
    "scheduler": "cosine",
    "warmup_ratio": 0.03,
    "gradient_checkpointing": true,
    "logging_steps": 5,
    "eval_strategy": "epoch",
    "save_strategy": "epoch",
    "adapter_dir": "results/adapter"
  }
}